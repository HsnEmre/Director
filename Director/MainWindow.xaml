<Window x:Class="Director.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Director.ViewModels"
        xmlns:views="clr-namespace:Director.Views"
        Title="Director"
        Width="1360"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:CreateFilmProjectViewModel}">
            <views:ProjectSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StoryGenerationViewModel}">
            <views:StoryGenerationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProjectHistoryViewModel}">
            <views:ProjectHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductionWorkspaceViewModel}">
            <views:ProductionWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="DIRECTOR" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="AI Film Studio" Foreground="{StaticResource BrushText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Text="Konfigurator" Foreground="{StaticResource BrushMutedText}" FontSize="12" FontWeight="SemiBold" />
                    <Button Content="1. Proje Ayarları" Command="{Binding NavigateProjectSetupCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,10,0,8" />
                    <Button Content="2. Hikaye Planı" Command="{Binding NavigateStoryCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                    <Button Content="3. Üretim" Command="{Binding NavigateProductionCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,28,0,0">
                    <TextBlock Text="Kütüphane" Foreground="{StaticResource BrushMutedText}" FontSize="12" FontWeight="SemiBold" />
                    <Button Content="Projelerim" Command="{Binding NavigateProjectHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource InfoCardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Aktif Adım" Foreground="{StaticResource BrushMutedText}" FontSize="12" />
                        <TextBlock Text="{Binding CurrentStep, Mode=OneWay}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="28,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentStep, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushText}" />
                        <TextBlock Text="Tek pencereli adım adım AI film hazırlama akışı" Foreground="{StaticResource BrushMutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BrushPanelAlt}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ActivitySummary, Mode=OneWay}" Foreground="{StaticResource BrushMutedText}" TextWrapping="Wrap" />
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding ActivityProgress, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>

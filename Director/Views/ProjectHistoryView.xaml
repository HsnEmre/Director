<UserControl x:Class="Director.Views.ProjectHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrushBackground}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Proje ara" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Durum" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Hikaye Türü" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StoryGenreOptions}" SelectedItem="{Binding SelectedStoryGenre, Mode=TwoWay}" IsEditable="True" />
                </StackPanel>
                <Button Grid.Column="5" Content="Yenile" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="16,24,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushText}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Proje" Binding="{Binding ProjectName}" Width="180" />
                    <DataGridTextColumn Header="Konu" Binding="{Binding SubjectPreview}" Width="260" />
                    <DataGridTextColumn Header="Süre" Binding="{Binding TotalDurationMinutes}" Width="60" />
                    <DataGridTextColumn Header="Klip" Binding="{Binding ClipDurationSeconds}" Width="60" />
                    <DataGridTextColumn Header="Sahne" Binding="{Binding CalculatedClipCount}" Width="70" />
                    <DataGridTextColumn Header="Tür" Binding="{Binding StoryGenre}" Width="110" />
                    <DataGridTextColumn Header="Stil" Binding="{Binding VisualStyle}" Width="140" />
                    <DataGridTextColumn Header="Çözünürlük" Binding="{Binding Resolution}" Width="100" />
                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="140" />
                    <DataGridTextColumn Header="Otonom" Binding="{Binding AutonomousGenerationStatusText}" Width="180" />
                    <DataGridCheckBoxColumn Header="Hikaye" Binding="{Binding HasStory}" Width="70" />
                    <DataGridTextColumn Header="Üretilen" Binding="{Binding GeneratedSceneCount}" Width="80" />
                    <DataGridTextColumn Header="Oluşturma" Binding="{Binding CreatedAt}" Width="140" />
                    <DataGridTextColumn Header="Güncelleme" Binding="{Binding UpdatedAt}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aç" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Hikaye Planına Git" Command="{Binding StoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Ayarları Düzenle" Command="{Binding EditSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Yeniden Üret" Command="{Binding StoryCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Sil" Command="{Binding DeleteCommand}" Style="{StaticResource GhostButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

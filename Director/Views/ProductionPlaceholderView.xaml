<UserControl x:Class="Director.Views.ProductionPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrushBackground}" Margin="24">
        <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Üretim" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Görsel ve video üretim modülü bir sonraki aşamada eklenecek." Foreground="{StaticResource BrushMutedText}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FilmProjectId, StringFormat=Proje ID: {0}}" Margin="0,14,0,0" Foreground="{StaticResource BrushAccent}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

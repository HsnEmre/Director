<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#0B1020</Color>
    <Color x:Key="ColorSurface">#111827</Color>
    <Color x:Key="ColorSurfaceRaised">#172033</Color>
    <Color x:Key="ColorSurfaceHover">#1E2A44</Color>
    <Color x:Key="ColorInput">#0F172A</Color>
    <Color x:Key="ColorInputHover">#15213A</Color>
    <Color x:Key="ColorBorder">#2C3A55</Color>
    <Color x:Key="ColorBorderStrong">#475569</Color>
    <Color x:Key="ColorText">#F8FAFC</Color>
    <Color x:Key="ColorMutedText">#CBD5E1</Color>
    <Color x:Key="ColorDisabledText">#64748B</Color>
    <Color x:Key="ColorPrimary">#8B5CF6</Color>
    <Color x:Key="ColorPrimaryHover">#A78BFA</Color>
    <Color x:Key="ColorPrimaryPressed">#7C3AED</Color>
    <Color x:Key="ColorAccent">#22D3EE</Color>
    <Color x:Key="ColorAccentSoft">#164E63</Color>
    <Color x:Key="ColorSelection">#4C1D95</Color>
    <Color x:Key="ColorDropdown">#111827</Color>
    <Color x:Key="ColorDropdownHover">#24324D</Color>
    <Color x:Key="ColorDropdownSelected">#312E81</Color>
    <Color x:Key="ColorDanger">#F87171</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorSuccess">#34D399</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushPanelAlt" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushPanelHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushMutedText" Color="{StaticResource ColorMutedText}" />
    <SolidColorBrush x:Key="BrushDisabledText" Color="{StaticResource ColorDisabledText}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushSelection" Color="{StaticResource ColorSelection}" />
    <SolidColorBrush x:Key="BrushDropdown" Color="{StaticResource ColorDropdown}" />
    <SolidColorBrush x:Key="BrushDropdownHover" Color="{StaticResource ColorDropdownHover}" />
    <SolidColorBrush x:Key="BrushDropdownSelected" Color="{StaticResource ColorDropdownSelected}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushInput" Color="{StaticResource ColorInput}" />
    <SolidColorBrush x:Key="BrushInputHover" Color="{StaticResource ColorInputHover}" />
</ResourceDictionary>
